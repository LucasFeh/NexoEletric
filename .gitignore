apply-report.txt
__pycache__/
Laser/
# config da MAQUINA (pasta padrao do BOM): caminho local, nao do projeto
hub-config.json

# credenciais do Odoo para a sincronizacao do almoxarifado (maquina, nao projeto)
hub-almox.json

# saida do sincronismo do almoxarifado: as libs binarias vindas da rede (a
# PcbLib sozinha tem 60 MB) e os espelhos que tools/almox/almox2lib.py escreve.
# Tudo isso refaz sozinho rodando o sync -- nao pertence ao historico.
Libs/Almox/
Libs/almox-basicos.js
Libs/almox-especiais.js
Libs/almox-index.js
Libs/almox-sync.js
# resumo do guardiao (tools/symbols/guardiao.py o reescreve a cada sincronismo)
Libs/almox-guardiao.js

# puxados do Odoo / relatorio da ultima rodada (tools/almox)
tools/almox/componentes_odoo.csv
tools/almox/relatorio.txt
tools/symbols/relatorio.txt

# NAO ignorar Libs/almox-parts.json: e o livro-razao rotulo -> part number.
# Ele e gerado, mas guarda estado; perder o arquivo renumera o almoxarifado.
#
# NAO ignorar Libs/almox-excluidos.json: e o REGISTRO do que o usuario apagou da
# biblioteca a mao, e quando. Desde 2026-09-17 o gerador NAO o consulta -- quem decide se
# um valor volta e o Odoo --, entao perder o arquivo nao ressuscita nada; perde o
# historico da limpeza, que e o unico lugar onde ele existe.

# NAO ignorar Libs/BIBLIOTECA DE ESQUEMA.SchLib: e a biblioteca da casa publicada
# dentro do repositorio (tools/libpath.py). Ela PRECISA viajar no push -- o hub do
# servidor nao alcanca o Y: nem a UNC do PC, e sem ela o gerador do almoxarifado
# sai sem footprint reciclado e com a folha preta no Altium.
#
# O que nao viaja e o que o schlib_patch escreve ao lado dela a cada save: 30
# rotacoes de backup de 1,7 MB cada, e o tmp do os.replace.
Libs/Backup-hub/
Libs/*.SchLib.tmp

# estado da bancada do BOM, escrito pelo hubserver dentro de Projects/<nome>/:
# os vistos do que ja foi montado e as opcoes com que a aba gerou o link. E de
# quem esta montando a placa, e muda a cada peça marcada -- nao e do projeto.
bom-vistos.json
bom-opts.json
# recibo do ultimo envio da lista ao Odoo: tudo nele volta de di_estado_lista(uid)
odoo-lista.json

# credenciais do envio ao Odoo. O ponto no nome NAO e enfeite: e o que faz o hubserver
# recusar servi-lo por HTTP (_serve, hubserver.py:120) -- ao contrario do hub-almox.json.
# O * e pelo temporario da gravacao (.hub-odoo.json.tmp, odoolista.py:437): se o os.replace
# falhar -- no Windows um antivirus ou editor segurando o destino basta -- sobra um arquivo
# untracked COM a senha dentro, a um "git add ." de ir para o servidor.
.hub-odoo.json*

# conversas do chat e os anexos. Elas carregam PRINT DE TELA em base64 -- do Altium, do ERP,
# do que o usuario recortou -- e ficariam a um "git add ." de ir para o repositorio. O ponto
# no nome tambem e o que faz o hubserver recusar servi-las por HTTP (_serve, hubserver.py:120),
# como no .hub-odoo.json acima.
.chat/

# ambiente virtual do servidor (o deploy cria /srv/altiumhub/.venv fora da release,
# mas quem instalar a mao dentro da arvore nao pode comitar isso)
.venv/
venv/

# lixeira do hub: /api/project/<id>/delete move a pasta do projeto para ca
# (hubserver.py, TRASH_DIR). E estado de maquina, e o hub SERVE o que esta dentro.
Trash/

# biblioteca remota (libremota.py) rodando fora do app desktop: o estado do espelho (ETag e
# sha1 por arquivo) e os backups do que era local e o servidor nao tinha. No app isso mora em
# .altiumhub/, que nem existe aqui. E estado da maquina, como o Trash/.
.lib-remota/

# a biblioteca de footprints do hub (o editor de footprint, hub-fplib.js) e os STEP dela: sao
# estado da biblioteca de cada servidor/maquina, gravado pelo hub -- nao viaja no push
Libs/pcblib-hub.js
Libs/3d-hub/
